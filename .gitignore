# Sitio compilado del JBook (se publica en la rama gh-pages, no se versiona aquí)
jbook/_build/

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/

# Datos crudos y resultados pesados del entregable 1 (no van al repo)
ITA Case Detail Data*.csv
*.joblib
*.npz
partition.csv

# Archivos de entrega
*.zip

# Entregable 3: los datos preparados conservan identificadores de casos y establecimientos (se regeneran)
results/cache/*.parquet
# Excepciones: predicciones de prueba (sin identificadores) y cálculos de los capítulos sí se versionan
!results/final/**/*.npz
!results/cache/*.joblib
!results/ensemble/**/*.npz

# Artefactos del dashboard final (livianos; Render los necesita)
!dashboard_final/artifacts/*.joblib
# Experimento pareado (proyecto final): predicciones por celda, sin identificadores
!results/pareado/**/*.npz
results/pareado/**/*.skip
